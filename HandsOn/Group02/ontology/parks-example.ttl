park:5896013 a parks:Park ;
    parks:parkName "Jardines de El Buen Retiro"^^xsd:string ;
    parks:description "Los jardines de El Buen Retiro, conocidos simplemente como El Retiro, son uno de los lugares más emblemáticos de Madrid y un oasis verde en el corazón de la ciudad."^^xsd:string .
