@prefix bm: <http://breathemadrid.es/ontology#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bm: a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    mod:createdWith <https://chowlk.linkeddata.es/> .

bm:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:domain bm:Station ;
    rdfs:range xsd:string .

bm:altitude a owl:DatatypeProperty ;
    rdfs:label "altitude" ;
    rdfs:domain bm:Station ;
    rdfs:range xsd:integer .

bm:dateTime a owl:DatatypeProperty ;
    rdfs:label "date time" ;
    rdfs:domain bm:Observation ;
    rdfs:range xsd:dateTime .

bm:hasStationType a owl:ObjectProperty ;
    rdfs:label "has station type" ;
    rdfs:domain bm:Station ;
    rdfs:range bm:StationType .

bm:isValid a owl:DatatypeProperty ;
    rdfs:label "is valid" ;
    rdfs:domain bm:Observation ;
    rdfs:range xsd:boolean .

bm:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    rdfs:domain bm:Station ;
    rdfs:range xsd:float .

bm:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in" ;
    rdfs:domain bm:Station ;
    rdfs:range bm:Municipality .

bm:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    rdfs:domain bm:Station ;
    rdfs:range xsd:float .

bm:measuresPollutant a owl:ObjectProperty ;
    rdfs:label "measures pollutant" ;
    rdfs:domain bm:Station ;
    rdfs:range bm:Pollutant .

bm:municipalityCode a owl:DatatypeProperty ;
    rdfs:label "municipality code" ;
    rdfs:domain bm:Municipality ;
    rdfs:range xsd:string .

bm:municipalityName a owl:DatatypeProperty ;
    rdfs:label "municipality name" ;
    rdfs:domain bm:Municipality ;
    rdfs:range xsd:string .

bm:observedAt a owl:ObjectProperty ;
    rdfs:label "observed at" ;
    rdfs:domain bm:Observation ;
    rdfs:range bm:Station .

bm:observesPollutant a owl:ObjectProperty ;
    rdfs:label "observes pollutant" ;
    rdfs:domain bm:Observation ;
    rdfs:range bm:Pollutant .

bm:pollutantCode a owl:DatatypeProperty ;
    rdfs:label "pollutant code" ;
    rdfs:domain bm:Pollutant ;
    rdfs:range xsd:string .

bm:pollutantName a owl:DatatypeProperty ;
    rdfs:label "pollutant name" ;
    rdfs:domain bm:Pollutant ;
    rdfs:range xsd:string .

bm:stationCode a owl:DatatypeProperty ;
    rdfs:label "station code" ;
    rdfs:domain bm:Station ;
    rdfs:range xsd:string .

bm:stationName a owl:DatatypeProperty ;
    rdfs:label "station name" ;
    rdfs:domain bm:Station ;
    rdfs:range xsd:string .

bm:typeCode a owl:DatatypeProperty ;
    rdfs:label "type code" ;
    rdfs:domain bm:StationType ;
    rdfs:range xsd:string .

bm:typeName a owl:DatatypeProperty ;
    rdfs:label "type name" ;
    rdfs:domain bm:StationType ;
    rdfs:range xsd:string .

bm:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:domain bm:Pollutant ;
    rdfs:range xsd:string .

bm:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:domain bm:Observation ;
    rdfs:range xsd:float .

dcterms:license a owl:AnnotationProperty .

dbo:Municipality a owl:Class ;
    rdfs:label "Municipality" .

sosa:ObservableProperty a owl:Class ;
    rdfs:label "Observable Property" .

sosa:Observation a owl:Class ;
    rdfs:label "Observation" .

sosa:Platform a owl:Class ;
    rdfs:label "Platform" .

bm:Municipality a owl:Class ;
    rdfs:label "Municipality" ;
    rdfs:subClassOf dbo:Municipality .

bm:StationType a owl:Class ;
    rdfs:label "Station Type" .

bm:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:subClassOf sosa:Observation .

bm:Pollutant a owl:Class ;
    rdfs:label "Pollutant" ;
    rdfs:subClassOf sosa:ObservableProperty .

bm:Station a owl:Class ;
    rdfs:label "Station" ;
    rdfs:subClassOf sosa:Platform .
